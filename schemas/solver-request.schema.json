{
  "$defs": {
    "Door": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Width",
          "type": "number"
        },
        "angle": {
          "default": 0,
          "title": "Angle",
          "type": "number"
        },
        "sweep": {
          "default": 90,
          "maximum": 180,
          "minimum": -180,
          "title": "Sweep",
          "type": "number"
        },
        "egress": {
          "default": true,
          "title": "Egress",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "width"
      ],
      "title": "Door",
      "type": "object"
    },
    "Equipment": {
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "switchboard",
            "switchgear",
            "panelboard",
            "transformer",
            "ats",
            "ups",
            "disconnect",
            "custom"
          ],
          "title": "Category",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "title": "Name",
          "type": "string"
        },
        "x": {
          "maximum": 100000,
          "minimum": -100000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100000,
          "minimum": -100000,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Depth",
          "type": "number"
        },
        "rotation": {
          "default": 0,
          "enum": [
            0,
            90,
            180,
            270
          ],
          "title": "Rotation",
          "type": "integer"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "working": {
          "default": 1000,
          "maximum": 10000,
          "minimum": 0,
          "title": "Working",
          "type": "number"
        },
        "rear": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rear"
        },
        "voltage": {
          "default": 120,
          "maximum": 100000,
          "minimum": 0,
          "title": "Voltage",
          "type": "integer"
        },
        "condition": {
          "default": 1,
          "enum": [
            1,
            2,
            3
          ],
          "title": "Condition",
          "type": "integer"
        },
        "status": {
          "default": "generic",
          "enum": [
            "generic",
            "user_entered",
            "unknown",
            "verified"
          ],
          "title": "Status",
          "type": "string"
        },
        "wall": {
          "default": "any",
          "enum": [
            "any",
            "north",
            "east",
            "south",
            "west"
          ],
          "title": "Wall",
          "type": "string"
        },
        "height": {
          "default": 2133.6,
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Height",
          "type": "number"
        },
        "bottom": {
          "default": 0,
          "maximum": 20000,
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/Zone"
          },
          "maxItems": 30,
          "title": "Zones",
          "type": "array"
        },
        "group": {
          "default": "",
          "title": "Group",
          "type": "string"
        },
        "definition": {
          "default": "",
          "title": "Definition",
          "type": "string"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "manufacturer": {
          "default": "",
          "title": "Manufacturer",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "panelSwing": {
          "default": 0,
          "maximum": 180,
          "minimum": 0,
          "title": "Panelswing",
          "type": "number"
        }
      },
      "required": [
        "id",
        "category",
        "name",
        "x",
        "y",
        "width",
        "depth"
      ],
      "title": "Equipment",
      "type": "object"
    },
    "Obstacle": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "column",
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 50000,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "exclusiveMinimum": 0,
          "maximum": 50000,
          "title": "Depth",
          "type": "number"
        },
        "bottom": {
          "default": 0,
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "top": {
          "default": 10000,
          "exclusiveMinimum": 0,
          "title": "Top",
          "type": "number"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "width",
        "depth"
      ],
      "title": "Obstacle",
      "type": "object"
    },
    "Project": {
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "title": "Name",
          "type": "string"
        },
        "units": {
          "default": "ft",
          "enum": [
            "mm",
            "ft"
          ],
          "title": "Units",
          "type": "string"
        },
        "room": {
          "$ref": "#/$defs/Room"
        },
        "equipment": {
          "items": {
            "$ref": "#/$defs/Equipment"
          },
          "maxItems": 100,
          "title": "Equipment",
          "type": "array"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/Region"
          },
          "maxItems": 100,
          "title": "Regions",
          "type": "array"
        },
        "scenarios": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 50,
          "title": "Scenarios",
          "type": "array"
        },
        "definitions": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 200,
          "title": "Definitions",
          "type": "array"
        },
        "underlay": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Underlay"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "jurisdiction": {
          "default": "",
          "title": "Jurisdiction",
          "type": "string"
        },
        "ruleEdition": {
          "default": "2023",
          "title": "Ruleedition",
          "type": "string"
        }
      },
      "required": [
        "name",
        "room",
        "equipment"
      ],
      "title": "Project",
      "type": "object"
    },
    "Region": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "exclusiveMinimum": 0,
          "title": "Depth",
          "type": "number"
        },
        "kind": {
          "enum": [
            "forbidden",
            "future",
            "required"
          ],
          "title": "Kind",
          "type": "string"
        },
        "hard": {
          "default": true,
          "title": "Hard",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "width",
        "depth",
        "kind"
      ],
      "title": "Region",
      "type": "object"
    },
    "Room": {
      "properties": {
        "defined": {
          "default": true,
          "title": "Defined",
          "type": "boolean"
        },
        "width": {
          "maximum": 50000,
          "minimum": 610,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "maximum": 50000,
          "minimum": 610,
          "title": "Depth",
          "type": "number"
        },
        "notch": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Notch",
          "type": "number"
        },
        "door": {
          "default": 1100,
          "maximum": 2000,
          "minimum": 600,
          "title": "Door",
          "type": "number"
        },
        "column": {
          "default": true,
          "title": "Column",
          "type": "boolean"
        },
        "height": {
          "default": 3048,
          "exclusiveMinimum": 0,
          "maximum": 30000,
          "title": "Height",
          "type": "number"
        },
        "boundary": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "maxItems": 200,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary"
        },
        "holes": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "maxItems": 50,
          "title": "Holes",
          "type": "array"
        },
        "doors": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Door"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doors"
        },
        "obstacles": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Obstacle"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obstacles"
        },
        "access_width": {
          "default": 914.4,
          "exclusiveMinimum": 0,
          "maximum": 5000,
          "title": "Access Width",
          "type": "number"
        },
        "check_access": {
          "default": false,
          "title": "Check Access",
          "type": "boolean"
        }
      },
      "required": [
        "width",
        "depth"
      ],
      "title": "Room",
      "type": "object"
    },
    "Settings": {
      "properties": {
        "grid_mm": {
          "default": 101.6,
          "enum": [
            10,
            25,
            50,
            100,
            12.7,
            25.4,
            50.8,
            101.6
          ],
          "title": "Grid Mm"
        },
        "max_time_seconds": {
          "default": 10,
          "maximum": 30,
          "minimum": 1,
          "title": "Max Time Seconds",
          "type": "integer"
        },
        "random_seed": {
          "default": 481516,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Random Seed",
          "type": "integer"
        },
        "return_limit": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Return Limit",
          "type": "integer"
        },
        "mode": {
          "default": "explore",
          "enum": [
            "explore",
            "improve",
            "repair"
          ],
          "title": "Mode",
          "type": "string"
        },
        "selected_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Ids",
          "type": "array"
        },
        "objective": {
          "default": "preserve",
          "enum": [
            "preserve",
            "access",
            "future",
            "balanced"
          ],
          "title": "Objective",
          "type": "string"
        },
        "job_id": {
          "default": "",
          "title": "Job Id",
          "type": "string"
        }
      },
      "title": "Settings",
      "type": "object"
    },
    "Zone": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "service",
            "ventilation",
            "removal",
            "future",
            "buffer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "side": {
          "enum": [
            "front",
            "rear",
            "left",
            "right",
            "top",
            "bottom"
          ],
          "title": "Side",
          "type": "string"
        },
        "distance": {
          "maximum": 20000,
          "minimum": 0,
          "title": "Distance",
          "type": "number"
        },
        "hard": {
          "default": true,
          "title": "Hard",
          "type": "boolean"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "bottom": {
          "default": 0,
          "title": "Bottom",
          "type": "number"
        },
        "top": {
          "default": 10000,
          "title": "Top",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "side",
        "distance"
      ],
      "title": "Zone",
      "type": "object"
    }
  },
  "properties": {
    "project": {
      "$ref": "#/$defs/Project"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    }
  },
  "required": [
    "project"
  ],
  "title": "SolveRequest",
  "type": "object"
}